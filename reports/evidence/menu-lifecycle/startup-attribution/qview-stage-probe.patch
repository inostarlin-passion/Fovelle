diff --git a/src/main.cpp b/src/main.cpp
index 62374de..55f8cdf 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -3,14 +3,33 @@
 #include "qvwin32functions.h"
 
 #include <QCommandLineParser>
+#include <QTemporaryDir>
+#include <QSettings>
+#include <QTimer>
+#include <QDebug>
+#include <QElapsedTimer>
 
 int main(int argc, char *argv[])
 {
+    QElapsedTimer profile;
+    profile.start();
+    const auto mark = [&profile](const char *phase) {
+        qInfo().noquote() << QString("FOVELLE_STARTUP phase=%1 elapsed_ms=%2")
+            .arg(phase).arg(profile.nsecsElapsed()/1000000.0, 0, 'f', 3);
+    };
     QCoreApplication::setAttribute(Qt::AA_EnableHighDpiScaling);
     QCoreApplication::setOrganizationName("qView");
     QCoreApplication::setApplicationName("qView");
     QCoreApplication::setApplicationVersion(QString::number(VERSION));
+    mark("application-identity");
+    // Measurement-only setup: isolate preferences and suppress onboarding.
+    QTemporaryDir benchmarkSettings;
+    QSettings::setDefaultFormat(QSettings::IniFormat);
+    QSettings::setPath(QSettings::IniFormat, QSettings::UserScope, benchmarkSettings.path());
+    QSettings().setValue("firstlaunch", true);
+    mark("settings-migrated");
     QVApplication app(argc, argv);
+    mark("application-constructed");
 
     QCommandLineParser parser;
     parser.addHelpOption();
@@ -29,9 +48,37 @@ int main(int argc, char *argv[])
     parser.process(app);
 #endif
 
-    auto *window = QVApplication::newWindow();
+    mark("command-line-parsed");
+    auto *window = [&] {
+        if (!qEnvironmentVariableIsSet("FOVELLE_BENCH_MAXIMIZED"))
+            return QVApplication::newWindow();
+        // Matched-workload sensitivity check: the same pre-show state as Fovelle.
+        mark("window-constructor-start");
+        auto *window = new MainWindow();
+        mark("window-constructor-complete");
+        window->setWindowState(Qt::WindowMaximized);
+        mark("window-state-ready");
+        window->show();
+        mark("window-shown");
+        window->raise();
+        mark("window-raised");
+        return window;
+    }();
+    mark("window-created");
     if (!parser.positionalArguments().isEmpty())
         QVApplication::openFile(window, parser.positionalArguments().constFirst(), true);
 
+    // qView constructs its application/window menus synchronously.
+    QTimer::singleShot(0, &app, [&] {
+        mark("first-event-loop-turn");
+        qInfo().noquote() << "FOVELLE_MAINWINDOW phase=menus-ready";
+    });
+    QTimer::singleShot(300, &app, [&] {
+        mark("system-probe");
+        qInfo().noquote() << QString("FOVELLE_SYSTEM_PROBE windows=1 maximized=%1 visible=%2")
+            .arg(window->isMaximized() ? "true" : "false")
+            .arg(window->isVisible() ? "true" : "false");
+        app.quit();
+    });
     return QApplication::exec();
 }
